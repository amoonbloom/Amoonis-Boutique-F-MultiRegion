# Backend API base. Always include the /api/v1 suffix (the API path,
# not /api-docs which is the Swagger UI page).
# Local:      http://localhost:5000/api/v1
# Production: https://amoonbloom-backend-production.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_ENV=development

# Google Tag Manager container ID (e.g. GTM-XXXXXXX) from the media team.
# Leave unset to disable GTM entirely (no script is injected) — used for the
# GA4 Enhanced Ecommerce "purchase" event fired on /order/success.
NEXT_PUBLIC_GTM_ID=

# Meta (Facebook) Pixel id. Optional — the id is hardcoded in
# src/lib/metaPixel.ts so the pixel works on every deploy without extra config.
# Set this only to point at a different pixel, or to an empty string to turn
# the pixel off for this environment. Fires PageView on every page and the
# standard Purchase event on /order/success.
# NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel id. Optional — the id is hardcoded in src/lib/tiktokPixel.ts
# (Amoon TIKTOK: CUKHVCRC77U8E2TJKLLG). Active only on /sa and /om routes.
# Set to an empty string to disable. Loads the basic snippet + ttq.page().
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Server-only shared secret sent as X-Internal-Key on SSR/ISR requests so the
# backend's per-IP rate limiter doesn't throttle server rendering. MUST match
# the backend's INTERNAL_API_KEY. NOT prefixed NEXT_PUBLIC_ — it must never
# reach the browser. Leave unset in local dev (backend limits are generous).
# INTERNAL_API_KEY=<long-random-string>

# First-guess region slug for a visitor with no prior choice (the edge proxy runs
# before the active-region list is available). Set to whichever market is live.
NEXT_PUBLIC_DEFAULT_REGION_SLUG=sa

# Tabby Pay-in-4 promo / checkout snippets (public key only — never the secret key).
# Must match the backend TABBY_PUBLIC_KEY / TABBY_MERCHANT_CODE for the same env.
# Snippets render only when the active region has tabbyEnabled=true.
# NEXT_PUBLIC_TABBY_PUBLIC_KEY=pk_test_…
# NEXT_PUBLIC_TABBY_MERCHANT_CODE=AmoonBloom
